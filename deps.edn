{:paths ["src"]

 :deps    {http-kit/http-kit    {:mvn/version "2.9.0-beta4"}
           org.babashka/json    {:mvn/version "0.1.7"}
           metosin/malli        {:mvn/version "0.20.3"}
           djblue/portal        {:mvn/version "0.69.1"}
           com.github.seancorfield/honeysql {:mvn/version "2.8.85"}
           camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}}

 :aliases 
 {:cljs 
   {:extra-deps {reagent/reagent {:mvn/version "2.0.1"}
                 re-frame/re-frame {:mvn/version "1.4.7"}}}
  :shadow-cljs
   {:extra-deps {thheller/shadow-cljs {:mvn/version "3.5.14"}}
    :main-opts ["-m" "shadow.cljs.devtools.cli"]}

  :nrepl 
   {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                 cider/cider-nrepl {:mvn/version "0.64.1"}}
     :main-opts ["-m" "nrepl.cmdline"
                 "--middleware" "[cider.nrepl/cider-middleware,refactor-nrepl.middleware/wrap-refactor]"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test}}}